{
  "add_fx": {
    "description": "Add an FX plugin to a track. Works for both instruments (VSTi) and effects (VST/AU).\nUse the exact plugin name as shown in REAPER's FX browser.\nBuilt-in Cockos plugins: ReaEQ, ReaComp, ReaDelay, ReaVerb, ReaLimit, ReaSynth,\nReaSamplOmatic5000, ReaTune, ReaGate, ReaFIR, ReaXcomp.",
    "input_schema": {
      "properties": {
        "fx_name": {
          "title": "Fx Name",
          "type": "string"
        },
        "track_index": {
          "title": "Track Index",
          "type": "integer"
        }
      },
      "required": [
        "track_index",
        "fx_name"
      ],
      "title": "add_fxArguments",
      "type": "object"
    }
  },
  "add_master_fx": {
    "description": "Add an FX plugin to the master track.",
    "input_schema": {
      "properties": {
        "fx_name": {
          "title": "Fx Name",
          "type": "string"
        }
      },
      "required": [
        "fx_name"
      ],
      "title": "add_master_fxArguments",
      "type": "object"
    }
  },
  "add_midi_note": {
    "description": "Add a MIDI note to an existing MIDI item.\npitch: MIDI note number 0\u2013127 (60 = middle C, 69 = A4).\nstart/length: seconds, relative to the item's start.\nchannel: MIDI channel 0\u201315 (use 9 for drums).",
    "input_schema": {
      "properties": {
        "channel": {
          "default": 0,
          "title": "Channel",
          "type": "integer"
        },
        "item_index": {
          "title": "Item Index",
          "type": "integer"
        },
        "length": {
          "title": "Length",
          "type": "number"
        },
        "pitch": {
          "title": "Pitch",
          "type": "integer"
        },
        "start": {
          "title": "Start",
          "type": "number"
        },
        "track_index": {
          "title": "Track Index",
          "type": "integer"
        },
        "velocity": {
          "default": 100,
          "title": "Velocity",
          "type": "integer"
        }
      },
      "required": [
        "track_index",
        "item_index",
        "pitch",
        "start",
        "length"
      ],
      "title": "add_midi_noteArguments",
      "type": "object"
    }
  },
  "add_pan_automation": {
    "description": "Add a pan automation point on a track, showing its pan envelope if needed.\npan: -1.0 (full left) to 1.0 (full right).",
    "input_schema": {
      "properties": {
        "pan": {
          "title": "Pan",
          "type": "number"
        },
        "position": {
          "title": "Position",
          "type": "number"
        },
        "track_index": {
          "title": "Track Index",
          "type": "integer"
        }
      },
      "required": [
        "track_index",
        "position",
        "pan"
      ],
      "title": "add_pan_automationArguments",
      "type": "object"
    }
  },
  "add_volume_automation": {
    "description": "Add a volume automation point on a track, showing its volume envelope if needed.\nposition: time in seconds. value_db: volume level in dB.",
    "input_schema": {
      "properties": {
        "position": {
          "title": "Position",
          "type": "number"
        },
        "track_index": {
          "title": "Track Index",
          "type": "integer"
        },
        "value_db": {
          "title": "Value Db",
          "type": "number"
        }
      },
      "required": [
        "track_index",
        "position",
        "value_db"
      ],
      "title": "add_volume_automationArguments",
      "type": "object"
    }
  },
  "adjust_pitch": {
    "description": "Adjust the pitch of an audio item by semitones (can be fractional).",
    "input_schema": {
      "properties": {
        "item_index": {
          "title": "Item Index",
          "type": "integer"
        },
        "semitones": {
          "title": "Semitones",
          "type": "number"
        },
        "track_index": {
          "title": "Track Index",
          "type": "integer"
        }
      },
      "required": [
        "track_index",
        "item_index",
        "semitones"
      ],
      "title": "adjust_pitchArguments",
      "type": "object"
    }
  },
  "adjust_playback_rate": {
    "description": "Adjust playback rate of an audio item. 1.0 = normal speed, 0.5 = half speed.",
    "input_schema": {
      "properties": {
        "item_index": {
          "title": "Item Index",
          "type": "integer"
        },
        "rate": {
          "title": "Rate",
          "type": "number"
        },
        "track_index": {
          "title": "Track Index",
          "type": "integer"
        }
      },
      "required": [
        "track_index",
        "item_index",
        "rate"
      ],
      "title": "adjust_playback_rateArguments",
      "type": "object"
    }
  },
  "analyze_audio": {
    "description": "Render once and measure it: the mix, or only `tracks` (soloed in place, so\ntheir sends to FX tracks are heard), over span = [start, end] seconds (default: whole project).\nfile: measure an audio file instead (a reference, or a render kept earlier).\ninclude: any of level, time, spectrum, stereo, rhythm, key (default all but key).\n  level: LUFS, true peak, peak, RMS, crest, clipped samples, DC.\n  time: LUFS per bar (for files, per 2 s or longer so there are at most 64).\n  spectrum: dB per octave band (resolution=\"third\" for 1/3 octaves), centroid, rolloff, flatness.\n  stereo: correlation, side/mid width dB, mono-sum loss dB, per band sub/low/mid/high/air.\n  rhythm: onset count and rate, estimated tempo.\n  key: most likely key and runner-up with correlation, pitch-class energy in % (C first).\npicture: also write a PNG (level + log spectrogram, bar lines) and return its path; Read it to look.\nkeep_render: save the rendered WAV here, to compare against later with file=.",
    "input_schema": {
      "properties": {
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "include": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Include"
        },
        "keep_render": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keep Render"
        },
        "picture": {
          "default": false,
          "title": "Picture",
          "type": "boolean"
        },
        "resolution": {
          "default": "octave",
          "title": "Resolution",
          "type": "string"
        },
        "span": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span"
        },
        "tracks": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tracks"
        }
      },
      "title": "analyze_audioArguments",
      "type": "object"
    }
  },
  "analyze_dynamics": {
    "description": "Render the project and measure dynamic range: RMS, peak, crest factor,\nand a simplified DR score (average peak-to-RMS over 3-second blocks).",
    "input_schema": {
      "properties": {},
      "title": "analyze_dynamicsArguments",
      "type": "object"
    }
  },
  "analyze_frequency_spectrum": {
    "description": "Render the project and analyze frequency band levels.\nReturns RMS level in dB for seven bands:\nsub_bass (20\u201360Hz), bass (60\u2013250Hz), low_mids (250\u2013500Hz),\nmids (500\u20132kHz), high_mids (2\u20134kHz), presence (4\u20138kHz), brilliance (8\u201320kHz).",
    "input_schema": {
      "properties": {},
      "title": "analyze_frequency_spectrumArguments",
      "type": "object"
    }
  },
  "analyze_loudness": {
    "description": "Render the project to a temp file and measure integrated loudness (LUFS)\nand true peak (dBTP) using the ITU-R BS.1770 standard.",
    "input_schema": {
      "properties": {},
      "title": "analyze_loudnessArguments",
      "type": "object"
    }
  },
  "analyze_stereo_field": {
    "description": "Render the project and analyze stereo width and mono compatibility.\nReturns mid/side balance, stereo width ratio, and L/R correlation.\nCorrelation near 1 = mono-like, near 0 = wide stereo, negative = phase issues.",
    "input_schema": {
      "properties": {},
      "title": "analyze_stereo_fieldArguments",
      "type": "object"
    }
  },
  "analyze_tracks": {
    "description": "Render each listed track alone over start..end and compare them: per track LUFS,\npeak, spectral centroid and octave-band levels (dB, shared bands_hz header), plus\nmasking: covered_pct = share of the track's energy where another listed track is\nlouder (per 1/3 octave, ~43 ms), and worst = the track covering most and where.",
    "input_schema": {
      "properties": {
        "end": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "start": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "tracks": {
          "items": {
            "type": "integer"
          },
          "title": "Tracks",
          "type": "array"
        }
      },
      "required": [
        "tracks"
      ],
      "title": "analyze_tracksArguments",
      "type": "object"
    }
  },
  "analyze_transients": {
    "description": "Render the project and detect transient events (note attacks, drum hits, etc.).\nReturns the count and timing of up to 100 transient onset events.",
    "input_schema": {
      "properties": {},
      "title": "analyze_transientsArguments",
      "type": "object"
    }
  },
  "apply_limiter": {
    "description": "Add ReaLimit to the master track and set its threshold and release.\nthreshold_db: -60 to +12 dB.\nrelease_db_per_sec: how fast gain reduction recovers, in dB per second as\nReaLimit displays it (about 6 and up; higher recovers faster; default 15).",
    "input_schema": {
      "properties": {
        "release_db_per_sec": {
          "default": 15.0,
          "title": "Release Db Per Sec",
          "type": "number"
        },
        "threshold_db": {
          "default": -0.5,
          "title": "Threshold Db",
          "type": "number"
        }
      },
      "title": "apply_limiterArguments",
      "type": "object"
    }
  },
  "apply_mastering_chain": {
    "description": "Add a standard mastering FX chain to the master track.\nPresets: default (EQ > Comp > Limiter), loud (EQ > Comp x2 > Limiter),\ngentle (EQ > light Comp > Limiter).\nAfter applying, use set_master_fx_parameter to dial in specific settings.\nUse list_master_fx + get_fx_parameters to discover parameter indices.",
    "input_schema": {
      "properties": {
        "preset": {
          "default": "default",
          "title": "Preset",
          "type": "string"
        }
      },
      "title": "apply_mastering_chainArguments",
      "type": "object"
    }
  },
  "audition_samples": {
    "description": "Measure every audio file in a folder (not its subfolders) to pick\none-shots without listening: one row per file, columns named once.\nmatch: keep files whose name contains this, case-insensitively (\"kick\").\ntail_s: seconds from the peak until 30 dB under it. pitch: the strongest\npeak between 30 and 500 Hz in the first 300 ms after the hit, as the\nnearest note and cents (\"F1+12\"); tune a kick or 808 by it.\ncentroid_hz: brightness. width_db: side vs mid, -120 for mono.",
    "input_schema": {
      "properties": {
        "folder": {
          "title": "Folder",
          "type": "string"
        },
        "limit": {
          "default": 40,
          "title": "Limit",
          "type": "integer"
        },
        "match": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Match"
        }
      },
      "required": [
        "folder"
      ],
      "title": "audition_samplesArguments",
      "type": "object"
    }
  },
  "bypass_fx": {
    "description": "Enable or bypass (disable) an FX plugin on a track.",
    "input_schema": {
      "properties": {
        "bypassed": {
          "title": "Bypassed",
          "type": "boolean"
        },
        "fx_index": {
          "title": "Fx Index",
          "type": "integer"
        },
        "track_index": {
          "title": "Track Index",
          "type": "integer"
        }
      },
      "required": [
        "track_index",
        "fx_index",
        "bypassed"
      ],
      "title": "bypass_fxArguments",
      "type": "object"
    }
  },
  "create_bus": {
    "description": "Create a new bus track and route the given tracks to it via sends.\ntrack_indices: list of track indices to feed into the bus.",
    "input_schema": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "track_indices": {
          "items": {
            "type": "integer"
          },
          "title": "Track Indices",
          "type": "array"
        }
      },
      "required": [
        "name",
        "track_indices"
      ],
      "title": "create_busArguments",
      "type": "object"
    }
  },
  "create_chord_progression": {
    "description": "Create a chord progression on a track as a single MIDI item.\nchords: comma-separated chord names, e.g. \"C,G,Am,F\" or \"Cm7,Fm7,Bb7,Ebmaj7\".\nSupports: maj, min/m, dim, aug, maj7, min7/m7, dom7/7, dim7, hdim7, sus2, sus4.\nAll chords are voiced around middle C (MIDI 60).",
    "input_schema": {
      "properties": {
        "beats_per_chord": {
          "default": 4,
          "title": "Beats Per Chord",
          "type": "integer"
        },
        "chords": {
          "title": "Chords",
          "type": "string"
        },
        "start_position": {
          "title": "Start Position",
          "type": "number"
        },
        "track_index": {
          "title": "Track Index",
          "type": "integer"
        }
      },
      "required": [
        "track_index",
        "chords",
        "start_position"
      ],
      "title": "create_chord_progressionArguments",
      "type": "object"
    }
  },
  "create_drum_pattern": {
    "description": "Create a drum pattern on a track using a step-sequencer string.\nEach character = one step. Characters: k=kick, s=snare, h=hihat(closed),\no=hihat(open), t=tom(low), m=tom(mid), f=tom(high), c=crash, r=ride, .=rest.\nExample 4/4 rock beat (16 steps): \"k...h...s...h...\"\nAll drum notes are placed on MIDI channel 9 (GM standard).",
    "input_schema": {
      "properties": {
        "beats": {
          "default": 4,
          "title": "Beats",
          "type": "integer"
        },
        "pattern": {
          "title": "Pattern",
          "type": "string"
        },
        "repeats": {
          "default": 1,
          "title": "Repeats",
          "type": "integer"
        },
        "start_position": {
          "title": "Start Position",
          "type": "number"
        },
        "track_index": {
          "title": "Track Index",
          "type": "integer"
        }
      },
      "required": [
        "track_index",
        "pattern",
        "start_position"
      ],
      "title": "create_drum_patternArguments",
      "type": "object"
    }
  },
  "create_midi_item": {
    "description": "Create an empty MIDI item on a track. Returns item_id for use with add_midi_note.",
    "input_schema": {
      "properties": {
        "length": {
          "title": "Length",
          "type": "number"
        },
        "start_position": {
          "title": "Start Position",
          "type": "number"
        },
        "track_index": {
          "title": "Track Index",
          "type": "integer"
        }
      },
      "required": [
        "track_index",
        "start_position",
        "length"
      ],
      "title": "create_midi_itemArguments",
      "type": "object"
    }
  },
  "create_project": {
    "description": "Create a new REAPER project, in a new project tab, with the given tempo and\ntime signature. The current project stays open, unsaved changes included.",
    "input_schema": {
      "properties": {
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "tempo": {
          "default": 120.0,
          "title": "Tempo",
          "type": "number"
        },
        "time_signature": {
          "default": "4/4",
          "title": "Time Signature",
          "type": "string"
        }
      },
      "title": "create_projectArguments",
      "type": "object"
    }
  },
  "create_send": {
    "description": "Create an aux send from one track to another.",
    "input_schema": {
      "properties": {
        "dest_track_index": {
          "title": "Dest Track Index",
          "type": "integer"
        },
        "source_track_index": {
          "title": "Source Track Index",
          "type": "integer"
        },
        "volume_db": {
          "default": 0.0,
          "title": "Volume Db",
          "type": "number"
        }
      },
      "required": [
        "source_track_index",
        "dest_track_index"
      ],
      "title": "create_sendArguments",
      "type": "object"
    }
  },
  "create_track": {
    "description": "Create a new track at the end of the project.\ntrack_type: audio, midi, instrument, folder",
    "input_schema": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "track_type": {
          "default": "audio",
          "title": "Track Type",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "create_trackArguments",
      "type": "object"
    }
  },
  "delete_track": {
    "description": "Delete a track by its index.",
    "input_schema": {
      "properties": {
        "track_index": {
          "title": "Track Index",
          "type": "integer"
        }
      },
      "required": [
        "track_index"
      ],
      "title": "delete_trackArguments",
      "type": "object"
    }
  },
  "detect_clipping": {
    "description": "Render the project and detect digital clipping (samples at or above 0 dBFS).\nReturns clipped sample count, peak level in dB, and whether clipping was found.",
    "input_schema": {
      "properties": {},
      "title": "detect_clippingArguments",
      "type": "object"
    }
  },
  "duck": {
    "description": "Sidechain-style ducking without routing: read the note starts on the trigger\ntrack (a kick) and, on each of tracks, automate a gain plugin named \"duck\"\n(added at the end of the chain if missing) to dip to depth_db at every hit\nand recover over release_beats. The fader stays free. Limit to\n[start_beat, end_beat) if given; replaces earlier duck points in that span.",
    "input_schema": {
      "properties": {
        "depth_db": {
          "default": -9.0,
          "title": "Depth Db",
          "type": "number"
        },
        "end_beat": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Beat"
        },
        "release_beats": {
          "default": 0.5,
          "title": "Release Beats",
          "type": "number"
        },
        "start_beat": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Beat"
        },
        "tracks": {
          "items": {
            "type": "integer"
          },
          "title": "Tracks",
          "type": "array"
        },
        "trigger": {
          "title": "Trigger",
          "type": "integer"
        }
      },
      "required": [
        "tracks",
        "trigger"
      ],
      "title": "duckArguments",
      "type": "object"
    }
  },
  "edit_audio_item": {
    "description": "Trim an audio item and/or add fades. All values in seconds.\nstart_trim: seconds to remove from the beginning.\nend_trim: seconds to remove from the end.\nfade_in/fade_out: fade length in seconds.",
    "input_schema": {
      "properties": {
        "end_trim": {
          "default": 0.0,
          "title": "End Trim",
          "type": "number"
        },
        "fade_in": {
          "default": 0.0,
          "title": "Fade In",
          "type": "number"
        },
        "fade_out": {
          "default": 0.0,
          "title": "Fade Out",
          "type": "number"
        },
        "item_index": {
          "title": "Item Index",
          "type": "integer"
        },
        "start_trim": {
          "default": 0.0,
          "title": "Start Trim",
          "type": "number"
        },
        "track_index": {
          "title": "Track Index",
          "type": "integer"
        }
      },
      "required": [
        "track_index",
        "item_index"
      ],
      "title": "edit_audio_itemArguments",
      "type": "object"
    }
  },
  "get_fx_parameters": {
    "description": "Get all parameters for an FX plugin, including names, indices, and current values.",
    "input_schema": {
      "properties": {
        "fx_index": {
          "title": "Fx Index",
          "type": "integer"
        },
        "track_index": {
          "title": "Track Index",
          "type": "integer"
        }
      },
      "required": [
        "track_index",
        "fx_index"
      ],
      "title": "get_fx_parametersArguments",
      "type": "object"
    }
  },
  "get_project_info": {
    "description": "Get information about the current project: name, path, tempo, tracks, length.",
    "input_schema": {
      "properties": {},
      "title": "get_project_infoArguments",
      "type": "object"
    }
  },
  "get_track_info": {
    "description": "Get detailed information about a track including FX and items.",
    "input_schema": {
      "properties": {
        "track_index": {
          "title": "Track Index",
          "type": "integer"
        }
      },
      "required": [
        "track_index"
      ],
      "title": "get_track_infoArguments",
      "type": "object"
    }
  },
  "import_audio_file": {
    "description": "Import an audio file onto a track at the given position (seconds).\nSupports all formats REAPER can read: wav, aiff, mp3, flac, ogg, etc.",
    "input_schema": {
      "properties": {
        "file_path": {
          "title": "File Path",
          "type": "string"
        },
        "position": {
          "default": 0.0,
          "title": "Position",
          "type": "number"
        },
        "track_index": {
          "title": "Track Index",
          "type": "integer"
        }
      },
      "required": [
        "file_path",
        "track_index"
      ],
      "title": "import_audio_fileArguments",
      "type": "object"
    }
